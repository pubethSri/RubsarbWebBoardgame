# Server
PORT=3000

# Public base URL of the app (used for OIDC redirect URIs).
# Leave unset for local dev (defaults to http://localhost:PORT).
# PUBLIC_URL=https://ito.example.com

# --- Authentik OIDC (OPTIONAL) ---
# The game runs fully anonymous without these; login is only needed
# for pack creation and the admin dashboard.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# AUTHENTIK_ISSUER=https://auth.example.com/application/o/ito-app/
# OIDC_APP_SLUG=ito-app
